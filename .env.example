# ---------------------------------------------------------------------------
# .env.example —— 环境变量模板（本文件不含真实密钥，可以安全提交）
#
# 使用方法（本地）：把本文件复制为同目录下的 .env，再填入真实值
#     copy .env.example .env          （Windows CMD / PowerShell 均可）
#
# 密钥只通过环境变量进入程序，绝不写进代码或提交到仓库。
#
# 重要：
#   1. 必须保存为 UTF-8 无 BOM。若带 BOM，第一个键名会变成
#      "\ufeffZHIPU_API_KEY"，脚本将读不到，症状是"明明配了却说没配"。
#   2. 键值两侧不要加引号、不要留空格，也不要写 export。
#   3. .env 已被 .gitignore 忽略，不会提交；本模板文件会被提交。
# ---------------------------------------------------------------------------

# ---- 至少填一组模型 Key（不要把真实 Key 提交到 Git）----
# 当前聊天默认走 DeepSeek；没有 DeepSeek Key 时会自动尝试智谱/Ollama 降级。
DEEPSEEK_API_KEY=sk-在这里填入你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# 智谱 AI（降级备用；RAG / embedding / 查询改写也可用）
# 获取地址：https://open.bigmodel.cn/  ->  API Keys
ZHIPU_API_KEY=sk-在这里填入你的智谱Key

# ---- 以下全部可选，不写则使用各脚本内的默认值 ----

# 智谱 OpenAI 兼容端点
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBED_MODEL=embedding-3
ZHIPU_CHAT_MODEL=glm-4-flash

# ---- 提速与路由（2026-10-16）----
# 查询/工具类问题自动走快速引擎（天气、翻译、查定义…）；情感陪伴仍走推理引擎。
# 设为 0 可关闭自动路由（一切都由选择器里的引擎决定）。
HEYTALK_AUTO_ROUTING=1
# 单次模型请求超时秒数（默认 120）；流式首字前会重试 HEYTALK_LLM_ATTEMPTS 次。
HEYTALK_LLM_TIMEOUT_S=120
HEYTALK_LLM_ATTEMPTS=2

# 本地 Ollama 降级引擎（用于离线演示；云端通常不可用）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- MongoDB（模块三「查学生」与模块五 Function Calling 使用）----
# 本地默认值 mongodb://localhost:27017/。
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=agent_db
MONGO_COLLECTION=students

# ---- MCP 子进程解释器（可选）----
# 默认用当前解释器 sys.executable；仅当需要指定别的解释器时才填。
# MCP_PYTHON=/path/to/python
