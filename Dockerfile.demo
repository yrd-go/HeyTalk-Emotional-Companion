FROM node:20-alpine AS frontend
WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HEYTALK_DEMO=1 \
    HEYTALK_DATA_DIR=/data \
    HEYTALK_HOST=0.0.0.0

WORKDIR /app
COPY requirements-demo.txt ./
RUN pip install --no-cache-dir -r requirements-demo.txt

COPY src ./src
COPY run.py ./
COPY data/emotional_handbook.txt ./data/emotional_handbook.txt
COPY --from=frontend /build/web/dist ./web/dist

RUN useradd --create-home --uid 10001 heytalk \
    && mkdir -p /data \
    && chown -R heytalk:heytalk /app /data
USER heytalk

EXPOSE 8600
HEALTHCHECK --interval=15s --timeout=4s --start-period=8s --retries=4 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:' + (os.environ.get('PORT') or os.environ.get('HEYTALK_PORT') or '8600') + '/api/bootstrap', timeout=3)"

CMD ["python", "run.py", "--demo", "--no-open", "--no-build", "--host", "0.0.0.0"]
